#!/usr/bin/make -f

export DH_VERBOSE=1

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

PKGDIR=debian/gherkinator

export GOCACHE=$(CURDIR)/debian/.gocache

%:
	dh $@

override_dh_auto_build:
	GHERKINATOR_VERSION=$(DEB_VERSION_UPSTREAM) GOFLAGS="-v -mod=vendor" just build

override_dh_auto_test:
	# Test requires fixtures generated by the justfile.

override_dh_auto_install:
	mkdir -p $(PKGDIR)/usr/bin
	install -m 0755 _build/bin/gherkinator $(PKGDIR)/usr/bin/gherkinator

# Disable dh_dwz because it cannot handle Go's compressed debug symbols.
override_dh_dwz:
