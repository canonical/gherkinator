set positional-arguments

# Build Debian package
[group("debian")]
build-deb *args:
    #!/usr/bin/env bash
    VERSION=$1
    DISTRO=$2
    PKG_NAME="gherkinator"
    REPO_ROOT={{ justfile_directory() }}

    WORKSPACE=$(mktemp -d)
    trap 'rm -rf "$WORKSPACE"' EXIT

    # Packages must be vendored since Launchpad does not allow
    # external network access on builders.
    go mod vendor
    git archive --format=tar --prefix=${PKG_NAME}-${VERSION}/ ${VERSION} \
        -o ${WORKSPACE}/${PKG_NAME}_${VERSION}.orig.tar
    tar --append -f ${WORKSPACE}/${PKG_NAME}_${VERSION}.orig.tar \
        --transform="s|^|$PKG_NAME-$VERSION/|" \
        vendor

    cd ${WORKSPACE}
    gzip -9 ${PKG_NAME}_${VERSION}.orig.tar
    tar -xzf ${PKG_NAME}_${VERSION}.orig.tar.gz
    cd "${PKG_NAME}-${VERSION}"

    cp -r ${REPO_ROOT}/build/debian ./debian
    sudo mk-build-deps --install --remove ./debian/control
    debuild -S -sa --no-sign  # Build source package,
    debuild -sa --no-sign  # Build binary package.

    cd ${WORKSPACE}
    mkdir -p ${REPO_ROOT}/_build/debian
    rm -rf ${PKG_NAME}-${VERSION}
    cp -r . ${REPO_ROOT}/_build/debian
    sudo apt purge ${PKG_NAME}-build-deps

