set positional-arguments

# Build Debian source package
build-deb-src *args:
    #!/usr/bin/env bash
    VERSION=$1
    DISTRO=$2
    PKG_NAME="gherkinator"
    REPO_ROOT={{ justfile_directory() }}

    WORKSPACE=$(mktemp -d)

    git archive --format=tar.gz --prefix="${PKG_NAME}-${VERSION}/" ${VERSION} \
        -o "${WORKSPACE}/${PKG_NAME}_${VERSION}.orig.tar.gz"

    cd "${WORKSPACE}"
    tar -xzf "${PKG_NAME}_${VERSION}.orig.tar.gz"
    cd "${PKG_NAME}-${VERSION}"

    cp -r "${REPO_ROOT}/build/debian" ./debian
    sbuild -d "${DISTRO}" --source --no-clean-source

    cd "${WORKSPACE}"
    mkdir -p "${REPO_ROOT}/_build"
    rm -rf "${PKG_NAME}-${VERSION}" "${PKG_NAME}_${VERSION}.orig.tar.gz"
    cp -r . "${REPO_ROOT}/_build"


